<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/pocketscan_surface"
    app:cardCornerRadius="20dp"
    app:strokeColor="@color/pocketscan_border"
    app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="36dp" android:layout_height="36dp" android:gravity="center" android:text="PDF" android:textColor="@color/pocketscan_blue_dark" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/bg_pill_blue" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="11dp" android:orientation="vertical">
                <TextView android:id="@+id/documentName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textColor="@color/pocketscan_text" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/documentCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:textColor="@color/pocketscan_blue_dark" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/documentAiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:padding="8dp" android:background="@drawable/bg_pill_blue" android:textColor="@color/pocketscan_blue_dark" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/openButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="@string/open" android:textAllCaps="false" android:textSize="12sp" app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/shareButton" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/share_document" android:textAllCaps="false" android:textSize="12sp" app:cornerRadius="14dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/renameButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="@string/rename_document" android:textAllCaps="false" android:textSize="11sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/deleteButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="@string/delete_document" android:textAllCaps="false" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
