<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_assistant" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/ai_description" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/aiExampleInvoices" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ai_example_invoices" />
            <Button android:id="@+id/aiExampleTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/ai_example_total" />
            <Button android:id="@+id/aiExampleYear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/ai_example_year" />
        </LinearLayout>
    </HorizontalScrollView>
    <EditText android:id="@+id/aiQuestion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="@string/ai_question_hint" android:inputType="textCapSentences|textMultiLine" android:minLines="2" />
    <Button android:id="@+id/aiAsk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/ask" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1"><TextView android:id="@+id/aiAnswer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ai_answer_placeholder" android:textIsSelectable="true" android:textSize="16sp" /></ScrollView>
</LinearLayout>
