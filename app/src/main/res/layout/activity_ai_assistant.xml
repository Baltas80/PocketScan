<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pocketscan_background"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ai_assistant"
        android:textColor="@color/pocketscan_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ai_description"
        android:textColor="@color/pocketscan_muted"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/aiExampleInvoices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_example_invoices" />
            <Button
                android:id="@+id/aiExampleTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/ai_example_total" />
            <Button
                android:id="@+id/aiExampleYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/ai_example_year" />
        </LinearLayout>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/aiQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_document_card"
        android:hint="@string/ai_question_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="2"
        android:padding="14dp"
        android:textColor="@color/pocketscan_text"
        android:textColorHint="@color/pocketscan_muted" />

    <Button
        android:id="@+id/aiAsk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="50dp"
        android:text="@string/ask" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <TextView
            android:id="@+id/aiAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_document_card"
            android:padding="16dp"
            android:text="@string/ai_answer_placeholder"
            android:textColor="@color/pocketscan_text"
            android:textIsSelectable="true"
            android:textSize="16sp" />
    </ScrollView>
</LinearLayout>
